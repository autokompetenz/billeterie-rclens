# ---------------------------------------------------------------------------
# Billetterie RC Lens — variables d'environnement
# Copiez ce fichier en « .env » et adaptez les valeurs.
# ---------------------------------------------------------------------------

# --- Serveur ---------------------------------------------------------------
# Port d'écoute de l'API Express (le frontend Vite tourne sur le port 3000).
PORT=3001

# URL publique de l'application (utilisée dans les e-mails et QR codes).
APP_URL="http://localhost:3000"

# Origines autorisées pour les appels cross-origin (séparées par des virgules).
# Laissez vide si le frontend est servi par le même serveur ou via le proxy Vite.
CORS_ORIGIN=""

# --- Base de données PostgreSQL / Neon -------------------------------------
# En local : postgresql://rclens:rclens@127.0.0.1:5433/billeterie
# Sur Neon  : la chaîne fournie par le tableau de bord (sslmode=require).
DATABASE_URL="postgresql://rclens:rclens@127.0.0.1:5433/billeterie"

# Force ou désactive SSL (sinon détection automatique pour Neon).
# PGSSL="true"

# Vérifie le certificat SSL du serveur (true par défaut).
# Passer à "false" uniquement pour un PostgreSQL local à certificat auto-signé.
# PGSSL_REJECT_UNAUTHORIZED="true"

# Nombre maximal de connexions du pool (faible conseillé en serverless).
# PG_POOL_MAX="5"

# Amorçage des données de démonstration au premier démarrage.
# À passer à "false" en production.
SEED_DEMO_DATA="true"

# Mot de passe attribué aux comptes de démonstration lors de l'amorçage.
# Compte principal : supporter@rclens.fr
SEED_PASSWORD="Bollaert2026!"

# --- Espace administrateur -------------------------------------------------
# Code secret d'accès à /admin. OBLIGATOIRE pour activer l'espace.
ADMIN_CODE="changez-ce-code"

# Secret de signature du cookie de session admin (recommandé en production).
# ADMIN_SESSION_SECRET="une-chaine-aleatoire-longue"

# --- E-mails transactionnels (SMTP Hostinger) ------------------------------
# Sans ces variables, les e-mails sont seulement écrits dans les logs et
# journalisés dans la table email_log (aucune commande n'est bloquée).
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="billetterie@votre-domaine.fr"
SMTP_PASS="mot-de-passe-smtp"

# Expéditeur affiché dans les e-mails.
MAIL_FROM="Billetterie RC Lens <billetterie@votre-domaine.fr>"

# Adresse qui reçoit la notification de chaque nouvelle commande.
ADMIN_EMAIL="billetterie@votre-domaine.fr"

# --- Frontend --------------------------------------------------------------
# URL de base de l'API côté frontend. Par défaut « /api » (proxy Vite / serveur
# de production). Ne la définir que si l'API est hébergée sur un autre domaine.
# VITE_API_URL="http://localhost:3001/api"

# Cible du proxy Vite en développement.
# VITE_API_PROXY="http://localhost:3001"

# Clé Gemini (facultatif, utilisée par les fonctionnalités IA existantes).
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
